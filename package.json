{
  "name": "smart-glasses-agent-poc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "lint:web": "pnpm --filter web lint",
    "dev:api": "uv run --directory apps/api fastapi dev app/main.py",
    "start:api": "uv run --directory apps/api uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "dev": "pnpm run dev:web",
    "check": "pnpm run build:web"
  }
}
